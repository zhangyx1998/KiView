{
  "name": "@kiview/vite-plugin",
  "version": "0.1.2",
  "private": true,
  "description": "Vite plugin: discovers KiCad projects, exports them through @kiview/kicad into a content-addressed cache and serves them as virtual:kiview/boards.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./contract": { "types": "./dist/contract.d.ts", "default": "./dist/contract.js" },
    "./config": { "types": "./dist/config.d.ts", "default": "./dist/config.js" }
  },
  "files": ["dist", "src"],
  "dependencies": {
    "@kiview/kicad": "0.1.2"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "vite": "8.3.2"
  },
  "engines": { "node": ">=22.14" }
}
